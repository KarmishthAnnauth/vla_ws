<?xml version="1.0"?>
<package format="3">
  <name>simlingo_f1tenth</name>
  <version>0.1.0</version>
  <description>
    Real-world SimLingo deployment on an F1TENTH car: camera on the Jetson AGX Orin,
    pose / speed / global path from the F1TENTH stack on the Jetson Nano, SimLingo
    inference on the Orin, and a trajectory-to-AckermannDriveStamped controller that
    drives the Nano's /drive topic.
  </description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ackermann_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- simlingo_ros.simlingo_pid: SimLingo's lateral PID (optional lateral controller) -->
  <depend>simlingo_ros</depend>
  <depend>python3-scipy</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
